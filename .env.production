# === 天机阁 生产环境配置 ===
# 复制此文件为 .env 并修改以下配置

SERVER_PORT=3001

# 请修改为随机生成的强密码（建议 32 位以上）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# SQLite 数据库路径（默认在 prisma 目录下）
DATABASE_URL=file:./prod.db

# 上传文件存储目录
UPLOAD_DIR=./uploads

# 前端 API 地址
NEXT_PUBLIC_API_URL=http://localhost:3001/api
