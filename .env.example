# === 天机阁 环境变量模板 ===

# Local runtime data. Do not store formal data in the source tree.
TIANJI_DATA_ROOT=D:\\TianjiData
TIANJI_BACKUP_ROOT=Z:\\设计资料\\10 周豪杰\\天机阁\\backups
DATABASE_URL=file:D:/TianjiData/database/tianji.db

# Server
SERVER_PORT=3001
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
# CORS - 生产环境允许的来源（逗号分隔）
# Development 模式会自动允许 localhost
# 生产环境必须设置此项
ALLOWED_ORIGINS=

# CORS - 开发环境额外允许的来源（逗号分隔，LAN 访问用）
# 填写宿主机的局域网 IP，例如 DEV_ALLOWED_ORIGINS=http://192.168.1.100:3000
# 多个用逗号分隔
DEV_ALLOWED_ORIGINS=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# LAN 访问时改为宿主机 IP，例如 NEXT_PUBLIC_API_URL=http://192.168.1.100:3001/api

# Node environment (development / production)
NODE_ENV=development

# Docker 启动时是否执行种子数据
RUN_SEED=false

