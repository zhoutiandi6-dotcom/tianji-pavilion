SERVER_PORT=3001
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
DATABASE_URL=file:./data/dev.db
NODE_ENV=development
ALLOWED_ORIGINS=

# ORG-PERM-001 Phase 4: compatibility is the production-safe default.
# Set to strict only in an isolated environment with operation memberships.
ORG_PERMISSION_ENFORCEMENT=compatibility

# 开发环境 LAN 访问允许的来源（逗号分隔）
DEV_ALLOWED_ORIGINS=
