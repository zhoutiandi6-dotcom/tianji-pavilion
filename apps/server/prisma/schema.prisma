// TianJi Pavilion - enterprise schema. OWNER is represented by role.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// Permission & Role
// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model Permission {
  id              Int              @id @default(autoincrement())
  action          String
  resource        String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// User - 鐢ㄦ埛锛圡ilestone A: +Owner, +Lockout锛?// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  password           String
  displayName        String
  email              String    @default("")
  roleId             Int
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  loginAttempts      Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  role                Role             @relation(fields: [roleId], references: [id])
  createdTasks        Task[]           @relation("TaskCreator")
  imageTasks          ImageTask[]      @relation("ImageTaskDesigner")
  imageTasksAssigned  ImageTask[]      @relation("ImageTaskAssignedBy")
  imageTasksApproved  ImageTask[]      @relation("ImageTaskApprovedBy")
  imageTasksSubmitted ImageTask[]      @relation("ImageTaskSubmittedBy")
  approvalRecordsMade ApprovalRecord[]
  submissionsMade     TaskSubmissionRecord[] @relation("TaskSubmissionSubmitter")
  submissionsWithdrawn TaskSubmissionRecord[] @relation("TaskSubmissionWithdrawnBy")
  submissionsProcessed TaskSubmissionRecord[] @relation("TaskSubmissionProcessedBy")
  weeklyPlansCreated  WeeklyPlan[] @relation("WeeklyPlanCreatedBy")
  weeklyPlansActivated WeeklyPlan[] @relation("WeeklyPlanActivatedBy")
  weeklyPlansClosed   WeeklyPlan[] @relation("WeeklyPlanClosedBy")
  weeklyPlanItemsAssigned WeeklyPlanItem[] @relation("WeeklyPlanItemDesigner")
  weeklyPlanItemsCancelled WeeklyPlanItem[] @relation("WeeklyPlanItemCancelledBy")
  weeklyDesignerPlans     WeeklyDesignerPlan[] @relation("WeeklyDesignerPlanDesigner")
  weeklyDesignerPlansCreated WeeklyDesignerPlan[] @relation("WeeklyDesignerPlanCreatedBy")
  weeklyDesignerPlanAdjustments WeeklyDesignerPlanAdjustment[] @relation("WeeklyDesignerPlanAdjustmentBy")
  weeklyOperationsApprovalPlans        WeeklyOperationsApprovalPlan[]     @relation("WeeklyOperationsApprovalPlanManager")
  weeklyOperationsApprovalPlansCreated WeeklyOperationsApprovalPlan[]     @relation("WeeklyOperationsApprovalPlanCreatedBy")
  weeklyOperationsApprovalPlanItemsAdded   WeeklyOperationsApprovalPlanItem[] @relation("WeeklyOperationsApprovalPlanItemAddedBy")
  weeklyOperationsApprovalPlanItemsRemoved WeeklyOperationsApprovalPlanItem[] @relation("WeeklyOperationsApprovalPlanItemRemovedBy")
  operationLogs       OperationLog[]
  uploadedAttachments Attachment[]
  announcements       Announcement[]

  @@index([roleId])
  @@map("users")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// Store - 搴楅摵
// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model Store {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById Int?

  tasks Task[]

  @@map("stores")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// RequirementType - 闇€姹傜被鍨?// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model RequirementType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById Int?

  tasks Task[]

  @@map("requirement_types")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// Task - 娉曟棬
// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model Task {
  id                      Int       @id @default(autoincrement())
  serialNumber            String    @unique
  productCode             String?
  productName             String?
  storeId                 Int?
  requirementTypeId       Int?
  compatibleProduct       String?
  requesterName           String?
  operatorOwner           String?
  submittedAt             DateTime?
  deadline                DateTime?
  imageCount              Int       @default(1)
  imageSize               String?
  usagePosition           String?
  taskType                String?
  overallRequirementType  String?
  unifiedModificationNote String?
  outputSpec              String?
  materialLinks           String?
  priority                String    @default("NORMAL")
  workflowStatus          String    @default("DRAFT")
  approverId              Int?
  approvalComment         String?
  approvedAt              String?
  creatorId               Int
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  deletedById             Int?

  creator         User             @relation("TaskCreator", fields: [creatorId], references: [id])
  store           Store?           @relation(fields: [storeId], references: [id])
  requirementType RequirementType? @relation(fields: [requirementTypeId], references: [id])
  approvalRecords ApprovalRecord[]
  submissionRecords TaskSubmissionRecord[]
  imageTasks      ImageTask[]
  attachments     Attachment[]
  weeklyOperationsApprovalPlanItems WeeklyOperationsApprovalPlanItem[]

  @@index([creatorId])
  @@index([storeId])
  @@index([requirementTypeId])
  @@index([deadline])
  @@index([workflowStatus])
  @@index([createdAt])
  @@map("tasks")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// ApprovalRecord - 瀹℃壒璁板綍
// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model ApprovalRecord {
  id         Int      @id @default(autoincrement())
  taskId     Int
  approverId Int
  action     String
  comment    String?
  createdAt  DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id])
  approver User @relation(fields: [approverId], references: [id])
  submissionRecord TaskSubmissionRecord?

  @@index([taskId])
  @@index([approverId])
  @@map("approval_records")
}

model TaskSubmissionRecord {
  id                 Int      @id @default(autoincrement())
  taskId             Int
  submitterId        Int
  submittedAt        DateTime @default(now())
  submissionType     String
  submissionSequence Int
  withdrawnAt        DateTime?
  withdrawnById      Int?
  processedAt        DateTime?
  processedById      Int?
  result             String   @default("PENDING")
  approvalRecordId   Int?     @unique
  createdAt          DateTime @default(now())

  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submitter      User            @relation("TaskSubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  withdrawnBy    User?           @relation("TaskSubmissionWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  processedBy    User?           @relation("TaskSubmissionProcessedBy", fields: [processedById], references: [id], onDelete: Restrict)
  approvalRecord ApprovalRecord? @relation(fields: [approvalRecordId], references: [id], onDelete: SetNull)

  @@unique([taskId, submissionSequence])
  @@index([taskId])
  @@index([submitterId])
  @@index([withdrawnById])
  @@index([processedById])
  @@index([submittedAt])
  @@index([result])
  @@map("task_submission_records")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// ImageTask - 鍥剧墖浠诲姟
// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model ImageTask {
  id                     Int       @id @default(autoincrement())
  taskId                 Int
  imageIndex             Int       @default(0)
  imageTitle             String
  imageType              String?
  requirementType        String?
  originalImageUrl       String?
  referenceImageUrl      String?
  requirement            String?
  useUnifiedRequirement  Boolean   @default(true)
  inheritFromImageIndex  Int?
  designerId             Int?
  assignedAt             DateTime?
  assignedById           Int?
  approvedAt             DateTime?
  approvedById           Int?
  submittedAt            DateTime?
  submittedById          Int?
  status                 String    @default("WAITING_OPS_APPROVAL")
  sortOrder              Int       @default(0)
  remark                 String?
  completedAttachmentUrl String?
  designNote             String?
  reviewStatus           String?
  reviewRemark           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  deletedById            Int?

  task        Task         @relation(fields: [taskId], references: [id])
  designer    User?        @relation("ImageTaskDesigner", fields: [designerId], references: [id])
  assignedBy  User?        @relation("ImageTaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  approvedBy  User?        @relation("ImageTaskApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  submittedBy User?        @relation("ImageTaskSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  attachments Attachment[]
  weeklyPlanItems WeeklyPlanItem[]

  @@index([taskId])
  @@index([designerId])
  @@index([assignedAt])
  @@index([assignedById])
  @@index([approvedAt])
  @@index([approvedById])
  @@index([submittedAt])
  @@index([submittedById])
  @@index([status])
  @@index([createdAt])
  @@map("image_tasks")
}

model WeeklyPlan {
  id            Int       @id @default(autoincrement())
  weekStart     DateTime  @unique
  weekEnd       DateTime
  status        String    @default("DRAFT")
  createdById   Int
  activatedAt   DateTime?
  activatedById Int?
  closedAt      DateTime?
  closedById    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy   User             @relation("WeeklyPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy User?            @relation("WeeklyPlanActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  closedBy    User?            @relation("WeeklyPlanClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  items       WeeklyPlanItem[]

  @@index([status])
  @@index([weekEnd])
  @@map("weekly_plans")
}

model WeeklyPlanItem {
  id            Int       @id @default(autoincrement())
  weeklyPlanId  Int
  imageTaskId   Int
  designerId    Int
  source        String
  status        String    @default("PLANNED")
  plannedAt     DateTime  @default(now())
  reassignedAt  DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledById Int?
  cancelReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  weeklyPlan  WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  imageTask   ImageTask  @relation(fields: [imageTaskId], references: [id], onDelete: Restrict)
  designer    User       @relation("WeeklyPlanItemDesigner", fields: [designerId], references: [id], onDelete: Restrict)
  cancelledBy User?      @relation("WeeklyPlanItemCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@unique([weeklyPlanId, imageTaskId])
  @@index([weeklyPlanId])
  @@index([imageTaskId])
  @@index([designerId])
  @@index([source])
  @@index([status])
  @@index([completedAt])
  @@map("weekly_plan_items")
}

// Legacy per-designer target storage. It is retained only for historical
// compatibility; formal weekly planning is calculated from WeeklyPlanItem and
// ImageTask and must not read or write targetImageCount.
model WeeklyDesignerPlan {
  id               Int       @id @default(autoincrement())
  designerId       Int
  weekStart        DateTime
  weekEnd          DateTime
  targetImageCount Int       @default(0) // legacy / deprecated
  createdById      Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  designer         User      @relation("WeeklyDesignerPlanDesigner", fields: [designerId], references: [id], onDelete: Restrict)
  createdBy        User      @relation("WeeklyDesignerPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  adjustments      WeeklyDesignerPlanAdjustment[]

  @@unique([designerId, weekStart])
  @@index([weekStart])
  @@index([designerId])
  @@map("weekly_designer_plans")
}

// Historical numeric target adjustments. New plan adjustments are audited as
// decree-level WeeklyPlan audit events instead of creating these records.
model WeeklyDesignerPlanAdjustment {
  id             Int       @id @default(autoincrement())
  planId         Int
  previousTarget Int
  newTarget      Int
  reason         String
  adjustedById   Int
  adjustedAt     DateTime  @default(now())

  plan           WeeklyDesignerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  adjustedBy     User      @relation("WeeklyDesignerPlanAdjustmentBy", fields: [adjustedById], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([adjustedAt])
  @@map("weekly_designer_plan_adjustments")
}

// Operations approval planning is decree-based. Image totals are snapshots from
// active decree items, not hand-entered targets.
model WeeklyOperationsApprovalPlan {
  id          Int       @id @default(autoincrement())
  managerId   Int
  weekStart   DateTime
  weekEnd     DateTime
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  manager   User      @relation("WeeklyOperationsApprovalPlanManager", fields: [managerId], references: [id], onDelete: Restrict)
  createdBy User      @relation("WeeklyOperationsApprovalPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     WeeklyOperationsApprovalPlanItem[]

  @@unique([managerId, weekStart])
  @@index([weekStart])
  @@index([managerId])
  @@map("weekly_operations_approval_plans")
}

model WeeklyOperationsApprovalPlanItem {
  id                        Int       @id @default(autoincrement())
  planId                    Int
  decreeId                  Int
  plannedImageCountSnapshot Int
  sourceType                String
  addedById                 Int
  addedAt                   DateTime  @default(now())
  removedAt                 DateTime?
  removedById               Int?
  removedReason             String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  plan      WeeklyOperationsApprovalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  decree    Task                         @relation(fields: [decreeId], references: [id], onDelete: Restrict)
  addedBy   User                         @relation("WeeklyOperationsApprovalPlanItemAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  removedBy User?                        @relation("WeeklyOperationsApprovalPlanItemRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([planId, decreeId])
  @@index([planId])
  @@index([decreeId])
  @@index([sourceType])
  @@index([removedAt])
  @@map("weekly_operations_approval_plan_items")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// Attachment - 闄勪欢
// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model Attachment {
  id            Int       @id @default(autoincrement())
  taskId        Int?
  imageTaskId   Int?
  category      String
  fileName      String
  fileType      String    @default("application/octet-stream")
  mimeType      String    @default("application/octet-stream")
  extension     String    @default("")
  fileSize      Int       @default(0)
  storagePath   String
  previewPath   String?
  thumbnailPath String?
  uploadedById  Int
  uploadedAt    DateTime  @default(now())
  deletedAt     DateTime?
  deletedById   Int?

  task       Task?      @relation(fields: [taskId], references: [id])
  imageTask  ImageTask? @relation(fields: [imageTaskId], references: [id])
  uploadedBy User       @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([imageTaskId])
  @@index([category])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("attachments")
}

// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲
// Notification - 閫氱煡
// 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲

model Notification {
  id          Int       @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  title       String
